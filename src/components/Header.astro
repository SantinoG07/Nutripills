---
import "../styles/global.css";
import BotonComprar from "./BotonComprar.astro";
import BotonHeader from "./BotonHeader.astro";
import BotonCarrito from "./BotonCarrito.astro"

const { escondercomprar = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white dark:bg-transparent backdrop-blur-sm " >
<div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">

    <div class="flex-1 md:flex md:items-center md:gap-12">
        <a class="block" href="/">
            <img src="/Logo.png" alt="NutriPills Logo" class="h-24 w-auto">
        </a>
    </div>

    <div class="md:flex md:items-center md:gap-12">
        <nav aria-label="Global" class="hidden md:flex md:items-center md:gap-2">
            
            <BotonHeader nombre="Inicio" id="/"/>
            <BotonHeader nombre="Acerca de" id="/Acerca"/>
            <BotonHeader nombre="Sobre Nosotros" id="/Sobrenosotros"/>
            <BotonHeader nombre="Contacto" id="/Contacto"/>
            <BotonCarrito/>
            {!escondercomprar && <BotonComprar />}

        </nav>

    </div>
    </div>
    </div>
</div>
</header>

